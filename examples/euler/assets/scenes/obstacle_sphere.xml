<!-- 基础障碍几何体：球体（static，无 joint，有碰撞）。
     基础尺寸：半径 0.25m（直径 0.5m），spawn 时通过 scale 缩放。
     颜色通过 OrcaGymScene.set_material_info 在 spawn 后覆盖。
     用于 Lesson 8 场景布景，为摄像头视频提供丰富的视觉内容。
     注：MuJoCo 原生不支持 cone 类型，用球体作为替代之一。 -->
<mujoco model="obstacle_sphere">
  <worldbody>
    <body name="obstacle_sphere" pos="0 0 0">
      <geom name="sphere_geom" type="sphere" size="0.25" rgba="0.7 0.3 0.7 1"/>
    </body>
  </worldbody>
</mujoco>
