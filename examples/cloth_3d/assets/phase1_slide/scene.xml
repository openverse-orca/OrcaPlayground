<mujoco model="phase1_slide">
  <!--
    MjcPBD phase1：单夹爪推块（无布）
    夹爪：手掌 + 两枚竖直平板指（法向 ⊥ 掌底水平面，沿掌底平面 Y 平移开合）
    5 个 OrcaLink body：base, cube, gripper_palm, gripper_finger1, gripper_finger2
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" solver="CG"
          cone="elliptic" impratio="12" tolerance="1e-7" iterations="200" noslip_iterations="2"/>
  <default>
    <joint damping="0.30" armature="0.001"/>
    <geom solref="0.025 1.2" solimp="0.94 0.997 0.0008" condim="3" friction="0.45 0.02 0.005"/>
  </default>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.2 0.2 0.2" specular="0.25 0.25 0.25"/>
  </visual>

  <worldbody>
    <light pos="0.5 -0.5 1.5" dir="-0.3 0.3 -1"/>
    <camera name="main" pos="1.1 -0.9 0.55" xyaxes="0.75 0.66 0 -0.28 0.32 0.90"/>

    <body name="base" pos="0 0 0.1">
      <geom name="base_geom" type="box" size="0.5 0.5 0.1" rgba="0.24 0.42 0.78 1"
            friction="0.45 0.02 0.005"/>
    </body>

    <body name="cube" pos="0 0 0.225">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.12"
            rgba="0.92 0.55 0.15 1" friction="0.50 0.03 0.008"/>
    </body>

    <!-- 掌体锚点 + 三 slide；指挂在掌底，竖直平板（对标 frank pad） -->
    <!-- 掌 z 需使竖直指最低点高于台面 z=0.2（指心 z≈掌_z-0.135） -->
    <body name="gripper_palm" pos="-0.18 0 0.36">
      <joint name="gripper_slide_x" type="slide" axis="1 0 0" range="-0.05 0.35" damping="25"/>
      <joint name="gripper_slide_y" type="slide" axis="0 1 0" range="-0.15 0.15" damping="25"/>
      <joint name="gripper_slide_z" type="slide" axis="0 0 1" range="-0.10 0.05" damping="35"/>
      <geom name="gripper_palm_geom" type="box" size="0.045 0.035 0.025"
            rgba="0.30 0.30 0.30 1" friction="1.0 0.04 0.01"/>

      <!-- 竖直平板：薄 Y（厚度）、宽 X、沿 -Z 向下；slide 在掌底 XY 平面内 -->
      <body name="gripper_finger1" pos="0 0.050 -0.070">
        <joint name="gripper_finger1_slide" type="slide" axis="0 -1 0" range="0 0.042" damping="10"/>
        <!-- 竖直平板：half_z 向下伸展，侧面 ⊥ 掌底平面（法向沿 ±Y） -->
        <geom name="gripper_finger1_geom" type="box" size="0.012 0.022 0.045"
              rgba="0.15 0.15 0.15 1" condim="4" friction="1.2 0.05 0.01"/>
      </body>

      <body name="gripper_finger2" pos="0 -0.050 -0.070">
        <joint name="gripper_finger2_slide" type="slide" axis="0 1 0" range="0 0.042" damping="10"/>
        <geom name="gripper_finger2_geom" type="box" size="0.012 0.022 0.045"
              rgba="0.15 0.15 0.15 1" condim="4" friction="1.2 0.05 0.01"/>
      </body>
    </body>
  </worldbody>

  <equality>
    <joint joint1="gripper_finger1_slide" joint2="gripper_finger2_slide"/>
  </equality>

  <tendon>
    <fixed name="gripper_grasp">
      <joint joint="gripper_finger1_slide" coef="0.35"/>
      <joint joint="gripper_finger2_slide" coef="0.35"/>
    </fixed>
  </tendon>

  <actuator>
    <position name="gripper_move_x" joint="gripper_slide_x" kp="180" dampratio="1"
              ctrlrange="-0.05 0.35"/>
    <position name="gripper_move_y" joint="gripper_slide_y" kp="700" dampratio="1"
              ctrlrange="-0.15 0.15"/>
    <position name="gripper_move_z" joint="gripper_slide_z" kp="850" dampratio="1"
              ctrlrange="-0.10 0.05"/>
    <position name="gripper_grasp_ctrl" tendon="gripper_grasp" kp="1250" dampratio="1"
              ctrlrange="0 0.042"/>
  </actuator>

</mujoco>
