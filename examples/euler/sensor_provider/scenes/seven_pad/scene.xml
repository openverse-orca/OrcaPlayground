        <body name="SevenPad-2__force_f4" pos="-0.011 0.019 0.010">
          <geom name="SevenPad-2__force_f4_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-2__pad_material" />
        </body>
        <body name="SevenPad-2__force_f5" pos="-0.022 0 0.010">
          <geom name="SevenPad-2__force_f5_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-2__pad_material" />
        </body>
        <body name="SevenPad-2__force_f6" pos="-0.011 -0.019 0.010">
          <geom name="SevenPad-2__force_f6_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-2__pad_material" />
        </body>
        <body name="SevenPad-2__force_f7" pos="0.011 -0.019 0.010">
          <geom name="SevenPad-2__force_f7_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-2__pad_material" />
        </body>
      </body>
    </body>
    <body name="load_2" pos="0.1 0 0.07">
      <freejoint />
      <geom type="box" size="0.035 0.019 0.02" mass="0.2" />
    </body>
  </worldbody>
  <asset>
    <material name="SevenPad-1__pad_material" rgba="0.15 0.65 0.55 1" />
    <material name="SevenPad-1__housing_material" rgba="0.2 0.25 0.3 1" />
    <material name="SevenPad-2__pad_material" rgba="0.15 0.65 0.55 1" />
    <material name="SevenPad-2__housing_material" rgba="0.2 0.25 0.3 1" />
  </asset>
  <!-- Exact mount sites anchor local pad/ray names; each DLL instance has its own noise seed. -->
  <custom>
    <text name="orca.sensor.v1/SevenPad-1/plugin" data="com.orca.examples.seven_pad" />
    <tuple name="orca.sensor.v1/SevenPad-1/object/force_f1">
