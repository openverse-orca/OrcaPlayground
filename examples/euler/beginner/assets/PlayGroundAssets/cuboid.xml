<mujoco model="cuboid">
  <option integrator="implicitfast" timestep="0.005" gravity="0 0 -9.81"/>
  <size memory="1000M" nuser_site="6"/>
  <compiler coordinate="local"/>

  <worldbody>
    <light cutoff="30" pos="0 1 1" dir="0 -1 -2"/>
    <light cutoff="30" pos="0 -1 1" dir="0 1 -2"/>

    <!-- 1.2x0.2x0.2 free-floating bar: rotation-teaching object
         (long axis makes Z-rotation visible, unlike the symmetric cube);
         blue to tell apart from the green cube / orange small cube -->
    <body name="cuboid" pos="0 0 0.1">
      <freejoint name="cuboid_joint"/>
      <geom type="box" contype="1" conaffinity="1" density="50"
            rgba="0.20 0.55 0.95 1"
            solimp="0.5 0.7 0.01" friction="0.5 0.004 0.0003"
            solref="0.02 1" priority="0" margin="0" condim="3" group="0"
            size="0.6 0.1 0.1"
            name="cuboid_geom"/>
    </body>
  </worldbody>

  <tendon/>
  <actuator/>
  <contact/>
  <equality/>
  <asset/>
</mujoco>
