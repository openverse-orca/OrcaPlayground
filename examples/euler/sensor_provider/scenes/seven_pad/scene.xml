        <body name="SevenPad-1__force_f5" pos="-0.022 0 0.010">
          <geom name="SevenPad-1__force_f5_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-1__pad_material" />
        </body>
        <body name="SevenPad-1__force_f6" pos="-0.011 -0.019 0.010">
          <geom name="SevenPad-1__force_f6_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-1__pad_material" />
        </body>
        <body name="SevenPad-1__force_f7" pos="0.011 -0.019 0.010">
          <geom name="SevenPad-1__force_f7_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-1__pad_material" />
        </body>
      </body>
    </body>
    <!-- Independent 0.1 kg and 0.2 kg loads cover each module's seven pads. -->
    <body name="load_1" pos="-0.1 0 0.07">
      <freejoint />
      <geom type="box" size="0.035 0.019 0.02" mass="0.1" />
    </body>
    <body name="mount_2" pos="0.1 0 0">
      <body name="SevenPad-2__sensor_root" pos="0 0 0" quat="1 0 0 0">
        <site name="SevenPad-2__sensor_base" pos="0 0 0" size="0.001" group="4" />
        <site name="SevenPad-2__range_frame" pos="0 0 0.012" size="0.001" group="4" />
        <geom name="SevenPad-2__housing_visual" type="box" pos="0 0 0.004" size="0.032 0.028 0.004" material="SevenPad-2__housing_material" contype="0" conaffinity="0" mass="0" group="1" />
        <body name="SevenPad-2__force_f1" pos="0 0 0.010">
          <geom name="SevenPad-2__force_f1_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-2__pad_material" />
        </body>
        <body name="SevenPad-2__force_f2" pos="0.022 0 0.010">
          <geom name="SevenPad-2__force_f2_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-2__pad_material" />
