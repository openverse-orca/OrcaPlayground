<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic teaching modules, not a manufacturer's model or a calibrated sensor. -->
<mujoco model="seven_pad_named_instances">
  <option timestep="0.001" integrator="implicit" cone="elliptic" />
  <worldbody>
    <body name="mount_1" pos="-0.1 0 0">
      <body name="SevenPad-1__sensor_root" pos="0 0 0" quat="1 0 0 0">
        <site name="SevenPad-1__sensor_base" pos="0 0 0" size="0.001" group="4" />
        <site name="SevenPad-1__range_frame" pos="0 0 0.012" size="0.001" group="4" />
        <geom name="SevenPad-1__housing_visual" type="box" pos="0 0 0.004" size="0.032 0.028 0.004" material="SevenPad-1__housing_material" contype="0" conaffinity="0" mass="0" group="1" />
        <body name="SevenPad-1__force_f1" pos="0 0 0.010">
          <geom name="SevenPad-1__force_f1_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-1__pad_material" />
        </body>
        <body name="SevenPad-1__force_f2" pos="0.022 0 0.010">
          <geom name="SevenPad-1__force_f2_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-1__pad_material" />
        </body>
        <body name="SevenPad-1__force_f3" pos="0.011 0.019 0.010">
          <geom name="SevenPad-1__force_f3_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-1__pad_material" />
        </body>
        <body name="SevenPad-1__force_f4" pos="-0.011 0.019 0.010">
          <geom name="SevenPad-1__force_f4_shape" type="box" size="0.006 0.006 0.002" material="SevenPad-1__pad_material" />
