<mujoco model="firefly">
  <compiler angle="radian" meshdir="meshes/"/>

  <asset>
    <texture name="texplane" type="2d" builtin="flat" rgb1="0.95 0.95 0.95" width="5120" height="5120"/>
    <material name="MatPlane" texture="texplane" texrepeat="1 1" texuniform="true" reflectance="0"/>
  </asset>

  <default>
    <light castshadow="false"/>
    <geom rgba="0.8 0.8 0.8 1"/>

    <default class="firefly">
      <joint limited="true" range="-1.5 1.5" damping="0.1" armature="0.001"/>
      <geom contype="1" conaffinity="1" condim="4" group="1" margin="0.001"/>

      <default class="main_body">
        <geom contype="0" conaffinity="0" group="1" rgba="0.9 0.4 0.1 1" mass="0"/>
      </default>

      <default class="blade">
        <geom contype="0" conaffinity="0" group="1" rgba="0.3 1 0.3 1" mass="0"/>
      </default>

      <default class="rotor_joint">
        <joint type="hinge" limited="false" damping="0.02" armature="0.0005"/>
      </default>

      <default class="collision">
        <geom contype="1" conaffinity="1" group="4" rgba="1 0.3 1 0.5" friction="2 0.0005 0.00001"/>
      </default>
    </default>
  </default>

  <visual>
    <headlight ambient="0.5 0.5 0.5"/>
  </visual>

  <worldbody>
    <light pos="0 0 1000" directional="false" diffuse="0.3 0.3 0.3" specular="0.3 0.3 0.3"/>

    <body name="drone_frame" pos="0 0 0">
      <joint name="drone_free" type="free"/>
      <body name="camera" pos="-0.5 0 0" euler="0 0 -1.570796">
        <camera name="indi_eye_camera" pos="0 0 0" fovy="90"/>
      </body>

      <body name="Drone" childclass="firefly" pos="0 0 0">
        <site name="drone_body_center_site" pos="0 0 0" group="3" size="0.01" rgba="1 1 0 0.8"/>
        <site name="drone_forward_site" pos="0.215 0 0" size="0.008" group="3" rgba="0 1 0 0.8"/>
        <site name="drone_up_site" pos="0 0 0.1" size="0.008" group="3" rgba="0 0.7 1 0.8"/>

        <inertial pos="0 0 0" mass="1.5" diaginertia="0.0347563 0.0458929 0.0806492"/>

        <geom name="body_visual" class="main_body" type="cylinder" size="0.05 0.08" rgba="0.9 0.4 0.1 1"/>
        <geom name="body_col_1" class="collision" type="cylinder" size="0.052 0.082"/>
        <geom name="arm_col_fl" class="collision" type="capsule" size="0.008 0.105"
              pos="0.093 0.054 0" quat="0.866025 0 0 0.5"/>
        <geom name="arm_col_l" class="collision" type="capsule" size="0.008 0.1075"
              pos="0 0.1075 0"/>
        <geom name="arm_col_bl" class="collision" type="capsule" size="0.008 0.105"
              pos="-0.093 0.054 0" quat="0.866025 0 0 -0.5"/>
        <geom name="arm_col_br" class="collision" type="capsule" size="0.008 0.105"
              pos="-0.093 -0.054 0" quat="0.866025 0 0 0.5"/>
        <geom name="arm_col_r" class="collision" type="capsule" size="0.008 0.1075"
              pos="0 -0.1075 0"/>
        <geom name="arm_col_fr" class="collision" type="capsule" size="0.008 0.105"
              pos="0.093 -0.054 0" quat="0.866025 0 0 -0.5"/>

        <body name="front_left_rotor" pos="0.186195 0.1075 0.037">
          <inertial pos="0 0 0" mass="0.005" diaginertia="1.667e-05 1.667e-05 3.125e-05"/>
          <joint class="rotor_joint" name="FL_joint" pos="0 0 0" axis="0 0 1"/>
          <site name="rotor_fl_site" pos="0 0 0" size="0.01" rgba="1 0.5 0 0.8"/>
          <geom class="blade" type="cylinder" size="0.1 0.003" rgba="0.3 1 0.3 0.7"/>
          <geom name="FL_rotor_col" class="collision" type="cylinder" size="0.1 0.005"/>
        </body>

        <body name="left_rotor" pos="0 0.215 0.037">
          <inertial pos="0 0 0" mass="0.005" diaginertia="1.667e-05 1.667e-05 3.125e-05"/>
          <joint class="rotor_joint" name="L_joint" pos="0 0 0" axis="0 0 1"/>
          <site name="rotor_l_site" pos="0 0 0" size="0.01" rgba="0.5 0.5 1 0.8"/>
          <geom class="blade" type="cylinder" size="0.1 0.003" rgba="0.3 0.6 1 0.7"/>
          <geom name="L_rotor_col" class="collision" type="cylinder" size="0.1 0.005"/>
        </body>

        <body name="back_left_rotor" pos="-0.186195 0.1075 0.037">
          <inertial pos="0 0 0" mass="0.005" diaginertia="1.667e-05 1.667e-05 3.125e-05"/>
          <joint class="rotor_joint" name="BL_joint" pos="0 0 0" axis="0 0 1"/>
          <site name="rotor_bl_site" pos="0 0 0" size="0.01" rgba="0.5 0.5 1 0.8"/>
          <geom class="blade" type="cylinder" size="0.1 0.003" rgba="0.3 0.6 1 0.7"/>
          <geom name="BL_rotor_col" class="collision" type="cylinder" size="0.1 0.005"/>
        </body>

        <body name="back_right_rotor" pos="-0.186195 -0.1075 0.037">
          <inertial pos="0 0 0" mass="0.005" diaginertia="1.667e-05 1.667e-05 3.125e-05"/>
          <joint class="rotor_joint" name="BR_joint" pos="0 0 0" axis="0 0 1"/>
          <site name="rotor_br_site" pos="0 0 0" size="0.01" rgba="0.5 0.5 1 0.8"/>
          <geom class="blade" type="cylinder" size="0.1 0.003" rgba="0.3 0.6 1 0.7"/>
          <geom name="BR_rotor_col" class="collision" type="cylinder" size="0.1 0.005"/>
        </body>

        <body name="right_rotor" pos="0 -0.215 0.037">
          <inertial pos="0 0 0" mass="0.005" diaginertia="1.667e-05 1.667e-05 3.125e-05"/>
          <joint class="rotor_joint" name="R_joint" pos="0 0 0" axis="0 0 1"/>
          <site name="rotor_r_site" pos="0 0 0" size="0.01" rgba="0.5 0.5 1 0.8"/>
          <geom class="blade" type="cylinder" size="0.1 0.003" rgba="0.3 0.6 1 0.7"/>
          <geom name="R_rotor_col" class="collision" type="cylinder" size="0.1 0.005"/>
        </body>

        <body name="front_right_rotor" pos="0.18601 -0.1075 0.037">
          <inertial pos="0 0 0" mass="0.005" diaginertia="1.667e-05 1.667e-05 3.125e-05"/>
          <joint class="rotor_joint" name="FR_joint" pos="0 0 0" axis="0 0 1"/>
          <site name="rotor_fr_site" pos="0 0 0" size="0.01" rgba="1 0.5 0 0.8"/>
          <geom class="blade" type="cylinder" size="0.1 0.003" rgba="0.3 1 0.3 0.7"/>
          <geom name="FR_rotor_col" class="collision" type="cylinder" size="0.1 0.005"/>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <gyro name="body_gyro" site="drone_body_center_site"/>
    <accelerometer name="body_linacc" site="drone_body_center_site"/>
    <framequat name="body_quat" objtype="site" objname="drone_body_center_site"/>
  </sensor>
</mujoco>
