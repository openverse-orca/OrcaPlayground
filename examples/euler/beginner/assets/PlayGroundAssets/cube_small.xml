<mujoco model="cube_small">
  <option integrator="implicitfast" timestep="0.005" gravity="0 0 -9.81"/>
  <size memory="1000M" nuser_site="6"/>
  <compiler coordinate="local"/>

  <worldbody>
    <light cutoff="30" pos="0 1 1" dir="0 -1 -2"/>
    <light cutoff="30" pos="0 -1 1" dir="0 1 -2"/>

    <!-- 0.1x0.1x0.1 free-floating cube: desk-scale teaching object,
         companion of the 1m cube (cube.xml); orange to tell apart -->
    <body name="cube_small" pos="0 0 0.05">
      <freejoint name="cube_small_joint"/>
      <geom type="box" contype="1" conaffinity="1" density="50"
            rgba="0.95 0.60 0.20 1"
            solimp="0.5 0.7 0.01" friction="0.5 0.004 0.0003"
            solref="0.02 1" priority="0" margin="0" condim="3" group="0"
            size="0.05 0.05 0.05"
            name="cube_small_geom"/>
    </body>
  </worldbody>

  <tendon/>
  <actuator/>
  <contact/>
  <equality/>
  <asset/>
</mujoco>
